// Soft additive fill for authored buffer-zone silhouettes.
CCEffect %{
  techniques:
  - passes:
    - vert: highlight-vs:vert
      frag: highlight-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one
          blendSrcAlpha: one
          blendDstAlpha: one
      rasterizerState:
        cullMode: none
      properties:
        glowColor: { value: [0.58, 1, 0.38, 0.78], editor: { type: color } }
        glowParams: { value: [0, 0.004, 0.34, 0] }
}%

CCProgram highlight-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif

  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 v_light;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    pos = cc_matViewProj * pos;
    uv0 = a_texCoord;
    v_light = a_color;
    return pos;
  }
}%

CCProgram highlight-fs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>

  in vec4 v_light;
  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform Highlight {
    vec4 glowColor;
    vec4 glowParams; // x intensity, y edge sample width, z fill strength
  };

  vec4 frag () {
    vec4 tex = texture(cc_spriteTexture, uv0) * v_light;
    vec2 s = vec2(glowParams.y);
    float edge = texture(cc_spriteTexture, uv0 + vec2(s.x, 0.0)).a;
    edge = min(edge, texture(cc_spriteTexture, uv0 - vec2(s.x, 0.0)).a);
    edge = min(edge, texture(cc_spriteTexture, uv0 + vec2(0.0, s.y)).a);
    edge = min(edge, texture(cc_spriteTexture, uv0 - vec2(0.0, s.y)).a);
    edge = min(edge, texture(cc_spriteTexture, uv0 + s).a);
    edge = min(edge, texture(cc_spriteTexture, uv0 - s).a);
    edge = min(edge, texture(cc_spriteTexture, uv0 + vec2(s.x, -s.y)).a);
    edge = min(edge, texture(cc_spriteTexture, uv0 + vec2(-s.x, s.y)).a);

    float rim = max(0.0, tex.a - edge);
    float fill = smoothstep(0.02, 0.35, tex.a);
    float amount = (fill * glowParams.z + rim * 0.20) * glowParams.x * glowColor.a;
    return vec4(glowColor.rgb * amount, amount);
  }
}%
