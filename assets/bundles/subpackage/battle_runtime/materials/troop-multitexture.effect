// Ordered Spine batching: eight textures, packed two-colour tint, per-vertex team outline.
CCEffect %{
  techniques:
  - passes:
    - vert: batch-vs:vert
      frag: batch-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: one
          blendDst: one_minus_src_alpha
          blendSrcAlpha: one
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        outlineColor: { value: [1, 0.215686275, 0.215686275, 1], editor: { type: color } }
        alphaThreshold: { value: 0.5 }
}%

CCProgram batch-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  in vec4 a_color2;
  #if USE_SPINE_WORLD
    uniform sampler2D worldData;
    vec4 worldTexel(float index) {
      vec2 pixel = vec2(mod(index, 128.0), floor(index / 128.0));
      return texture(worldData, (pixel + vec2(0.5)) / 128.0);
    }
  #else
    in vec3 a_batch;
  #endif
  out vec2 v_uv;
  out vec4 v_light;
  out vec4 v_dark;
  out vec3 v_batch;
  vec4 vert () {
    v_uv = a_texCoord;
    v_light = a_color;
    v_dark = a_color2;
    #if USE_SPINE_WORLD
      float instance = floor(a_position.z / 8.0);
      float first = instance * 3.0;
      vec4 columnX = worldTexel(first);
      vec4 columnY = worldTexel(first + 1.0);
      vec4 translation = worldTexel(first + 2.0);
      v_batch = vec3(mod(a_position.z, 8.0), columnX.w, columnY.w);
      vec4 worldPosition = vec4(columnX.xyz * a_position.x + columnY.xyz * a_position.y + translation.xyz, 1.0);
      return cc_matViewProj * worldPosition;
    #else
      v_batch = a_batch;
      return cc_matViewProj * vec4(a_position, 1.0);
    #endif
  }
}%

CCProgram batch-fs %{
  precision highp float;
  #include <builtin/internal/alpha-test>
  in vec2 v_uv;
  in vec4 v_light;
  in vec4 v_dark;
  in vec3 v_batch;
  uniform Outline { vec4 outlineColor; };
  uniform sampler2D texture0;
  uniform sampler2D texture1;
  uniform sampler2D texture2;
  uniform sampler2D texture3;
  uniform sampler2D texture4;
  uniform sampler2D texture5;
  uniform sampler2D texture6;
  uniform sampler2D texture7;

  vec4 sampleSpine(vec2 uv) {
    if (v_batch.x < 0.5) return texture(texture0, uv);
    if (v_batch.x < 1.5) return texture(texture1, uv);
    if (v_batch.x < 2.5) return texture(texture2, uv);
    if (v_batch.x < 3.5) return texture(texture3, uv);
    if (v_batch.x < 4.5) return texture(texture4, uv);
    if (v_batch.x < 5.5) return texture(texture5, uv);
    if (v_batch.x < 6.5) return texture(texture6, uv);
    return texture(texture7, uv);
  }
  vec4 frag () {
    vec4 texColor = sampleSpine(v_uv);
    vec4 o;
    o.a = texColor.a * v_light.a;
    o.rgb = ((texColor.a - 1.0) * v_dark.a + 1.0 - texColor.rgb) * v_dark.rgb + texColor.rgb * v_light.rgb;
    vec2 s = v_batch.yz;
    if (max(s.x, s.y) > 0.0) {
      float edge = sampleSpine(v_uv + vec2(s.x, 0.0)).a;
      edge = min(edge, sampleSpine(v_uv - vec2(s.x, 0.0)).a);
      edge = min(edge, sampleSpine(v_uv + vec2(0.0, s.y)).a);
      edge = min(edge, sampleSpine(v_uv - vec2(0.0, s.y)).a);
      edge = min(edge, sampleSpine(v_uv + s).a);
      edge = min(edge, sampleSpine(v_uv - s).a);
      edge = min(edge, sampleSpine(v_uv + vec2(s.x, -s.y)).a);
      edge = min(edge, sampleSpine(v_uv + vec2(-s.x, s.y)).a);
      float contour = (1.0 - smoothstep(0.05, 0.8, edge)) * outlineColor.a;
      o.rgb = mix(o.rgb, outlineColor.rgb * o.a, contour);
    }
    ALPHA_TEST(o);
    return o;
  }
}%
